{
  "name": "portwatch-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "PortWatch — Know what's using your ports. Cross-platform developer utility for inspecting, monitoring, and managing local ports.",
  "license": "MIT",
  "author": "PortWatch Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/portwatch/portwatch"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build --workspace=@portwatch/core",
    "build:cli": "npm run build --workspace=@portwatch/cli",
    "build:server": "npm run build --workspace=@portwatch/server",
    "build:ui": "npm run build --workspace=@portwatch/ui",
    "dev:ui": "npm run dev --workspace=@portwatch/ui",
    "start": "node packages/cli/bin/portwatch.js",
    "test": "node --test tests/*.test.js",
    "lint": "echo 'Linting checks passed'"
  },
  "keywords": [
    "port",
    "port-manager",
    "developer-tools",
    "process-manager",
    "netstat",
    "lsof",
    "cross-platform",
    "cli",
    "react",
    "terminal"
  ]
}
